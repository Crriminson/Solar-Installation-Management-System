# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=solar_db
POSTGRES_USER=solar_app
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Public enquiry form rate limit. Raise for demos, e.g. 1000/hour.
PUBLIC_ENQUIRY_RATE=20/hour

# Sign-in attempts per client.
LOGIN_RATE=10/minute

# Proxies in front of Django. 0 when Django is reached directly.
TRUSTED_PROXY_COUNT=0

# ============================================================
# Telegram (F16)
# ============================================================

# From @BotFather: /newbot, then copy the token it replies with.
# Secret. Never commit it, never paste it into a chat or a log.
# Leave empty to run against a fake transport: everything works and the
# tests pass, but no message leaves the machine.
TELEGRAM_BOT_TOKEN=

# The bot's public @username, without the @. Needed to build the
# customer's linking deep link, which the token cannot provide.
TELEGRAM_BOT_USERNAME=

# Where a customer's phone reaches this app. A signing link is useless
# if it points at localhost. Leave empty until there is a real host.
PUBLIC_BASE_URL=
