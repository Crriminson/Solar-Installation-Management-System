# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=solar_db
POSTGRES_USER=solar_app
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Public enquiry form rate limit. Raise for demos, e.g. 1000/hour.
PUBLIC_ENQUIRY_RATE=20/hour

# Sign-in attempts per client.
LOGIN_RATE=10/minute

# Proxies in front of Django. 0 when Django is reached directly.
TRUSTED_PROXY_COUNT=0
